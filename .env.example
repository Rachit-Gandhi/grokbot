# Discord — create an application at https://discord.com/developers/applications
# Enable privileged intent: MESSAGE CONTENT INTENT
DISCORD_TOKEN=

# OpenAI-compatible API
# Examples:
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://host.docker.internal:11434/v1   (or your VPS LAN IP)
#   OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Fallback when channel has no topic/config model
DEFAULT_MODEL=gpt-4o-mini

# Optional: comma-separated Discord guild (server) IDs
GUILD_ALLOWLIST=

# Optional overrides
# SYSTEM_PROMPT=You are a helpful assistant in Discord.
# MAX_HISTORY=40
# STREAM_REPLIES=true
# SQLITE_PATH=data/grokbot.db
# CONFIG_PATH=configs/config.yaml
